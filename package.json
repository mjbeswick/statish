{
  "name": "statish",
  "version": "0.0.0",
  "private": true,
  "description": "A no-code-first state runtime, live inspector, editor, API server, and React integration toolkit.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @statish/studio dev",
    "serve:example": "pnpm --filter @statish/cli dev examples/checkout/chart.json --editable",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
